REDROID_SOURCE_DIR="$HOME/work/redroid-aosp15"
REDROID_CACHE_DIR="$HOME/.cache/custom-redroid"
REDROID_SYNC_JOBS=4
REDROID_BUILD_JOBS=4
REDROID_BUILDER_IMAGE=redroid-builder:a15-ubuntu22.04
# {date} expands to the packaging date in Korea (YYMMDD).
# Repackaging on the same date replaces the tag with the latest image.
REDROID_IMAGE_TAG=gth1919/psyki:redroid-custom-15.0.0-64only-{date}
# Set this only when Git identity is configured in another file.
# REDROID_GIT_CONFIG="$HOME/.gitconfig"
# Set the Windows drive that stores the WSL virtual disk.
# REDROID_BACKING_DIR=/mnt/d
