// Device-node manager that connects scrcpy --keyboard=uhid devices inside the redroid container.
cc_binary {
    name: "custom_uhid_inputd",
    vendor: true,
    srcs: ["uhid_inputd.c"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    shared_libs: ["liblog"],
    init_rc: ["custom_uhid_inputd.rc"],
}

// ESC on the scrcpy UHID keyboard is sent as BACK. The framework finds this file by the device name.
prebuilt_usr_keylayout {
    name: "custom_scrcpy_keylayout",
    vendor: true,
    src: "scrcpy.kl",
    filename: "scrcpy.kl",
}
