# Portainer 스택의 Environment variables에 넣거나 stack.env로 사용합니다.
# 값을 비워 두면 docker-compose.yml의 기본값을 씁니다.

# remote_load.py로 가져온 이미지 태그 또는 ID
REDROID_IMAGE=redroid-custom:15.0.0-64only-261028

# ADB 포트 (scrcpy -s <NAS 주소>:<포트>)
REDROID_ADB_PORT=5555

# 화면 설정
REDROID_WIDTH=720
REDROID_HEIGHT=1280
REDROID_DPI=240
REDROID_FPS=30
